<h2>Actualités</h2>

<div class="news">
  {% if site.news_fr != blank %}
    {% assign news_size = site.news_fr | size %}
    {% assign mois = "janvier,février,mars,avril,mai,juin,juillet,août,septembre,octobre,novembre,décembre" | split: "," %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news_fr | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          {% assign idx = item.date | date: "%-m" | minus: 1 %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: "%-d" }} {{ mois[idx] }} {{ item.date | date: "%Y" }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>Aucune actualité pour le moment...</p>
  {% endif %}
</div>
